{
  "room": {
    "type": "text",
    "label": "Phòng yêu cầu",
    "placeholder": "Ví dụ: Phòng 502, Hội trường B1..."
  },
  "date": {
    "type": "text",
    "label": "Ngày đặt phòng",
    "placeholder": "Ví dụ: 2025-05-10"
  },
  "time": {
    "type": "text",
    "label": "Thời gian đặt phòng",
    "placeholder": "Ví dụ: 08:00 - 11:30 (GMT+7)"
  },
  "estimatedAttendees": {
    "type": "number",
    "label": "Số người dự kiến",
    "placeholder": "Ví dụ: 25"
  },
  "purpose": {
    "type": "text",
    "label": "Mục đích sử dụng",
    "placeholder": "Mô tả mục đích sử dụng..."
  },
  "specialRequirements": {
    "type": "text",
    "label": "Yêu cầu đặc biệt",
    "placeholder": "Ghi chú thiết bị hoặc sắp xếp đặc biệt..."
  },
  "notificationEmail": {
    "type": "text",
    "label": "Email nhận thông báo",
    "placeholder": "recipient@example.com"
  },
  "ccEmail": {
    "type": "text",
    "label": "Email CC (Tùy chọn)",
    "placeholder": "cc@example.com"
  },
  "requesterName": {
    "type": "text",
    "label": "Họ tên người yêu cầu",
    "placeholder": "Nguyễn Văn A"
  },
  "requesterEmail": {
    "type": "text",
    "label": "Email người yêu cầu",
    "placeholder": "nguyenvana@example.com"
  },
  "requesterId": {
    "type": "text",
    "label": "MSSV / Mã cán bộ",
    "placeholder": "20210001"
  },
  "requesterRole": {
    "type": "text",
    "label": "Vai trò người yêu cầu",
    "placeholder": "Trưởng ban tổ chức"
  },
  "requesterDepartment": {
    "type": "option",
    "label": "Khoa / Viện / Trường",
    "placeholder": "Chọn khoa/viện/trường"
  },
  "organizationName": {
    "type": "text",
    "label": "Câu lạc bộ / Tổ chức",
    "placeholder": "CLB EdTech, Đội TNV..."
  },
  "equipmentName": {
    "type": "option",
    "label": "Tên thiết bị",
    "placeholder": "Chọn thiết bị cần mượn"
  },
  "quantity": {
    "type": "number",
    "label": "Số lượng thiết bị",
    "placeholder": "1"
  },
  "borrowDate": {
    "type": "text",
    "label": "Ngày mượn",
    "placeholder": "Ví dụ: 2025-05-15"
  },
  "returnDate": {
    "type": "text",
    "label": "Ngày trả",
    "placeholder": "Ví dụ: 2025-05-16"
  },
  "borrowerPhone": {
    "type": "text",
    "label": "Số điện thoại liên hệ",
    "placeholder": "0912345678"
  },
  "eventName": {
    "type": "text",
    "label": "Tên sự kiện",
    "placeholder": "Ví dụ: Workshop AI & Robotics 2025"
  },
  "eventDate": {
    "type": "text",
    "label": "Ngày diễn ra sự kiện",
    "placeholder": "Ví dụ: 2025-06-01"
  },
  "supportType": {
    "type": "option",
    "label": "Hạng mục hỗ trợ",
    "placeholder": "Chọn hạng mục hỗ trợ"
  }
}